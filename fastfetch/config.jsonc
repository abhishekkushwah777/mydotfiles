
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/FastfetchPngs/*.png",
    "height": 15,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },

  "display": {
    "separator": " : ",
    "disableLinewrap": true,
    "key": {
      "type": "string",
      "width": 13
    },
    "color": {
      "keys": "#B9A7F5",
      "title": "#A7E8D4"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{##A7E8D4}{user-name}{#}@{##B9A7F5}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{##77778F}┌────────────── Hardware ──────────────┐{#}"
    },
    {
      "type": "host",
      "key": "󰌢 PC"
    },
    {
      "type": "cpu",
      "key": "󰻠",
      "format": "{name} ({cores}) @ {freq-max} GHz"
    },
    {
      "type": "gpu",
      "key": "󰢮"
    },
    {
      "type": "memory",
      "key": "󰍛",
      "format": "{used} / {total} GiB ({percentage}%)"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}%)"
    },
    {
      "type": "custom",
      "format": "{##77778F}└────────────────────────────────────┘{#}"
    },
    "break",

    {
      "type": "custom",
      "format": "{##77778F}┌────────────── Software ──────────────┐{#}"
    },
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "kernel",
      "key": "󰌢"
    },
    {
      "type": "packages",
      "key": "󰏖"
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "de",
      "key": "󰧨 DE"
    },
    {
      "type": "wm",
      "key": "󰖯 WM"
    },
    {
      "type": "terminal",
      "key": "󰆍"
    },
    {
      "type": "custom",
      "format": "{##77778F}└────────────────────────────────────┘{#}"
    },
    "break",

    {
      "type": "custom",
      "format": "{##77778F}┌────────── Uptime / Age / Date ──────┐{#}"
    },
    {
      "type": "uptime",
      "key": "󰥔 Uptime"
    },
    {
      "type": "datetime",
      "key": "󰃭 DateTime",
      "format": "{year}-{month}-{day} {hour}:{minute}:{second}"
    },
    {
      "type": "custom",
      "format": "{##77778F}└────────────────────────────────────┘{#}"
    },
    "break",
    "colors",
    "break",
    "break"
  ]
}
